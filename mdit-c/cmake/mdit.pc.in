prefix=@MDIT_PC_PREFIX@
exec_prefix=${prefix}
libdir=@MDIT_PC_LIBDIR@
includedir=@MDIT_PC_INCLUDEDIR@

Name: mdit
Description: C99 port of markdown-it-py — fast, configurable Markdown parser
URL: https://github.com/executablebooks/markdown-it-py
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmdit
Cflags: -I${includedir} -I${includedir}/mdit

@PACKAGE_INIT@

# mditConfig.cmake — drop-in package config for `find_package(mdit)`.
#
# Usage from a downstream CMake project:
#
#   find_package(mdit REQUIRED)
#   target_link_libraries(my_app PRIVATE mdit::mdit)
#
# The `mdit::mdit` IMPORTED target carries everything callers need:
# the library itself, public include directories, and the warning /
# sanitizer interface targets the upstream build pulls in.

include("${CMAKE_CURRENT_LIST_DIR}/mditTargets.cmake")

# Provide a stable alias name. The internal CMake target is
# `mdit::mdit_static` for historical reasons — it may resolve to either
# a static archive or a versioned shared library depending on how the
# upstream build was configured (`-DMDIT_BUILD_SHARED=ON` flips it).
# Downstream code links to `mdit::mdit` so it doesn't have to care.
if(NOT TARGET mdit::mdit AND TARGET mdit::mdit_static)
    add_library(mdit::mdit ALIAS mdit::mdit_static)
endif()

check_required_components(mdit)
